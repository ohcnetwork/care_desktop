# ============================================================================
# CARE clinic web address. Full setup guide: docs/tls.md
#
# TEMPLATE - copied to tls.env at build time. The real tls.env is gitignored
# because it holds a live API token. The installer fills these in.
# ============================================================================

# Public name this clinic is served as, e.g. clinic.example.com. Needs an A record
# pointing at this computer, proxy off (grey cloud).
CARE_PUBLIC_HOST=

# Cloudflare API token with Zone:DNS:Edit on that domain's zone.
CLOUDFLARE_API_TOKEN=

# Certificate authority. Use staging while testing - production allows only 5
# identical certificates per week.
#   staging: https://acme-staging-v02.api.letsencrypt.org/directory
CARE_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# HSTS lifetime in seconds. 0 disables.
CARE_HSTS_SECONDS=2592000

# Which of this computer's addresses clients use. Leave empty unless this machine is
# on two networks at once - typically because it is itself the WiFi hotspot.
#   Raspberry Pi as access point:  CARE_LAN_IP=192.168.4.1
CARE_LAN_IP=
