# CARE clinic reverse proxy - HTTPS only, one origin. See docs/architecture.md.
#
# No plain-HTTP door by design: a plaintext entry point can be intercepted and
# stripped, undoing the encryption it hands off to. Port 80 is not served at all.
{
	# disable_redirects, not off: keeps certificate management while stopping Caddy
	# binding :80 for a redirect we don't want.
	auto_https disable_redirects
	order coraza_waf first # must run before reverse_proxy

	acme_ca {$CARE_ACME_CA}
}

https://{$CARE_PUBLIC_HOST} {
	# DNS-01: the only challenge that works from behind the clinic router's NAT.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Ask public resolvers directly - a router doing DNS-rebinding filtering or
		# aggressive caching would stall the challenge until it times out.
		resolvers 1.1.1.1 8.8.8.8
	}

	encode gzip

	# Set at the edge so they cover the React app and the file buckets, not just
	# Django's responses. No HSTS `preload`: it is a one-way door. See docs/tls.md.
	header {
		Strict-Transport-Security "max-age={$CARE_HSTS_SECONDS}"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# WAF on /api only (buckets excluded - uploads false-positive).
	# SecRuleEngine: Off (inert) -> DetectionOnly (log) -> On (block); restart to apply.
	handle /api/* {
		coraza_waf {
			load_owasp_crs
			directives `
				Include @coraza.conf-recommended
				Include @crs-setup.conf.example
				Include @owasp_crs/*.conf
				SecRuleEngine Off
			`
		}
		reverse_proxy backend:9000
	}
	handle /static/* {
		reverse_proxy backend:9000
	}
	handle /ping/* {
		reverse_proxy backend:9000
	}
	handle /health/* {
		reverse_proxy backend:9000
	}

	handle /patient-bucket/* {
		reverse_proxy minio:9000
	}
	handle /facility-bucket/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy frontend:80
	}
}
