# CARE clinic reverse proxy - HTTPS only, ONE origin, trusted LAN only.
# The site is served over https://care.local with a self-signed *internal* cert
# (no public CA can sign a .local name). Plain http on :80 only bounces to https,
# so there is no http surface and no CORS to configure.
{
	# Keep cert automation on (so `tls internal` can issue), but don't let Caddy
	# auto-add its own :80 redirects - we define an explicit redirect site below.
	auto_https disable_redirects
	order coraza_waf first # must run before reverse_proxy

	# Rename the internal CA so trust prompts (e.g. the iOS profile screen) show
	# "CARE Desktop Local CA" instead of Caddy's default "Caddy Local Authority".
	# Only affects a freshly-minted root; delete the caddy-data volume to re-mint.
	pki {
		ca local {
			name "CARE Desktop"
			root_cn "CARE Desktop Local CA"
			intermediate_cn "CARE Desktop Local CA - Intermediate"
		}
	}
}

# The cert-trust bootstrap (install page + root CA), served on BOTH http and
# https. iOS Safari auto-upgrades http->https, so the page must exist on https
# too or Safari lands on the frontend 404 before the device trusts us.
(bootstrap) {
	handle_path /setup* {
		root * /setup
		# Written by the engine each start, with the CA embedded (see certscript.go).
		@installer path /install-cert.sh /install-cert.ps1
		header @installer Content-Disposition "attachment"
		header @installer Content-Type "application/octet-stream"
		file_server {
			index index.html
		}
	}
	# The root CA, served only via the setup page (its button carries ?ok=1).
	# A direct visit with neither the marker nor a same-site referer is bounced
	# back to the instructions.
	handle /root.crt {
		@direct {
			not query ok=1
			not header Referer *care.local*
		}
		route {
			redir @direct /setup 302
			header Content-Type application/x-x509-ca-cert
			root * /data/caddy/pki/authorities/local
			file_server
		}
	}
}

# The site body, shared by every https listener below.
(site) {
	encode gzip

	# WAF on /api only (buckets excluded - uploads false-positive).
	# SecRuleEngine: Off (inert) -> DetectionOnly (log) -> On (block); restart to apply.
	handle /api/* {
		coraza_waf {
			load_owasp_crs
			directives `
				Include @coraza.conf-recommended
				Include @crs-setup.conf.example
				Include @owasp_crs/*.conf
				SecRuleEngine Off
			`
		}
		reverse_proxy backend:9000
	}
	handle /static/* {
		reverse_proxy backend:9000
	}
	handle /ping/* {
		reverse_proxy backend:9000
	}
	handle /health/* {
		reverse_proxy backend:9000
	}

	handle /patient-bucket/* {
		reverse_proxy minio:9000
	}
	handle /facility-bucket/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy frontend:80
	}
}

# http is gone EXCEPT the trust bootstrap: a device can't open https until it
# trusts our root, so the install page and the cert file are served over plain
# http. Everything else is permanently redirected to https.
:80 {
	import bootstrap
	handle {
		redir https://{host}{uri} permanent
	}
}

care.local:443 {
	tls internal # self-signed cert from Caddy's local CA (LAN name, no public CA)
	# Bootstrap first so /setup + /root.crt win over site's catch-all. Needed on
	# https too: iOS Safari auto-upgrades http->https and would otherwise land on
	# the frontend 404 before the device trusts our root.
	import bootstrap
	import site
}

# localhost over https, /ping/ only - lets the app's own health probe hit
# https://localhost/ping/ without depending on mDNS resolving on the server itself.
localhost:443 {
	tls internal
	reverse_proxy /ping/* backend:9000
}
