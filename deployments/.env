# ============================================================================
# Release pins. This file is the SINGLE source of truth for every image and
# source ref the clinic runs.
#
# Docker Compose auto-loads this file from the project directory, and the app
# embeds a copy for use before an install dir exists. There are deliberately no
# fallback values in docker-compose.yml or in Go: a version must be declared
# here or the stack refuses to start, rather than quietly running something else.
#
# Third-party images are tracked manually: check upstream release notes before
# bumping, and read docs/configuration.md for the upgrade hazards (Postgres
# majors in particular are one-way).
#
# Clinic *settings* (passwords, hostnames, feature flags) do NOT belong here --
# Compose interpolates this file, so everything in it is visible project-wide.
# Those live in backend.env / frontend.env and are editable in the app's UI.
# ============================================================================

# --- Third-party images -----------------------------------------------------
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:8.8.0-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CADDY_IMAGE=caddy:2.11.4

# --- Images we build at setup -----------------------------------------------
# Tags carry the input they were built from, so changing a pin above forces a
# rebuild instead of silently reusing a stale image. See internal/compose.
# BACKUP_IMAGE is built FROM POSTGRES_IMAGE: its pg_dump must match the server,
# or the daily backup fails once Postgres moves.
BACKUP_IMAGE=care-backup:clinic
CADDY_WAF_IMAGE=care-caddy:clinic
BACKEND_IMAGE=care:clinic
FRONTEND_IMAGE=care_fe:clinic

# --- CARE source ------------------------------------------------------------
# No upstream release to pin yet, so these track `develop`. When one exists,
# set the refs to tags and give the images matching tags above.
CARE_BE_REPO=https://github.com/ohcnetwork/care.git
CARE_FE_REPO=https://github.com/ohcnetwork/care_fe.git
CARE_BE_REF=develop
CARE_FE_REF=develop
