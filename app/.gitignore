# build artifacts
build/bin/
# staged at build time from the repo-root kit (source of truth lives at ../) —
# only the placeholder is tracked, so //go:embed compiles on a clean checkout.
install/*
!install/.gitkeep
# frontend
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
# wails-generated (bindings + dep hash are regenerated each build/dev)
frontend/wailsjs/
frontend/package.json.md5
# wails-generated Windows inputs: icon from appicon.png, tools rendered from
# wails.json, WebView2 bootstrapper from the Wails CLI. build/windows/* else is source.
build/windows/icon.ico
build/windows/installer/wails_tools.nsh
build/windows/installer/tmp/
# wails dev
.wails/
# design-sync (claude.ai/design): staged converter, build output, machine state
frontend/.ds-sync/
frontend/ds-bundle/
frontend/.design-sync/.cache/
frontend/.design-sync/learnings/
frontend/.design-sync/node_modules
