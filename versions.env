# Third-party images.
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:8.8.0-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CADDY_IMAGE=caddy:2.11.4

# Backup sidecar: Postgres + openssl, built from backup.Dockerfile at setup so
# daily dumps can be encrypted offline. See backup.Dockerfile.
BACKUP_IMAGE=care-backup:clinic

# Reverse proxy with the Coraza WAF (OWASP CRS) compiled in, built from
# caddy.Dockerfile at setup. CADDY_IMAGE above is the pinned base it's built from.
CADDY_WAF_IMAGE=care-caddy:clinic

# CARE backend + frontend: built from source. No upstream release to pin yet, so
# these track `develop`. When one exists, set the refs + image tags:
#   CARE_BE_REF=vX.Y.Z
#   CARE_FE_REF=vX.Y.Z
#   BACKEND_IMAGE=care:vX.Y.Z
#   FRONTEND_IMAGE=care_fe:vX.Y.Z
