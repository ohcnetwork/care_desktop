# Third-party images.
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:8.8.0-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CADDY_IMAGE=caddy:2.11.4

# CARE backend + frontend: built from source. No upstream release to pin yet, so
# these track `develop`. When one exists, set the refs + image tags:
#   CARE_BE_REF=vX.Y.Z
#   CARE_FE_REF=vX.Y.Z
#   BACKEND_IMAGE=care:vX.Y.Z
#   FRONTEND_IMAGE=care_fe:vX.Y.Z
