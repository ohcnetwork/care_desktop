# ============================================================================
# CARE frontend settings - baked into the app image at BUILD time (Vite).
# Edit a value here, then `care rebuild-frontend` to apply.
#
# These OVERRIDE care_fe's own committed .env (which supplies logos, locales, etc.).
# The app is served at, and calls its API at, the same host -> same-origin, no CORS.
# ============================================================================

# Backend base URL WITHOUT the /api suffix. The engine OVERWRITES this with the
# clinic's real address (CARE_PUBLIC_HOST) at every build, so the value here is only
# a placeholder that keeps the Vite build's validator happy.
REACT_CARE_API_URL=https://clinic.example.com

# Optional clinic tweaks (uncomment / edit as needed):
# REACT_ALLOWED_LOCALES="en,hi,ta,ml,mr,kn"
# REACT_DEFAULT_COUNTRY=
