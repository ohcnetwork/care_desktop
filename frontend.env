# ============================================================================
# CARE frontend settings - baked into the app image at BUILD time (Vite).
# Edit a value here, then `care rebuild-frontend` to apply.
#
# These OVERRIDE care_fe's own committed .env (which supplies logos, locales, etc.),
# so you usually only need the API URL. The app is served at, and calls its API at,
# the same host -> same-origin, no CORS.
# ============================================================================

# Backend base URL WITHOUT the /api suffix. MUST be a valid URL (the FE build
# rejects empty). Same host as the app -> same-origin.
REACT_CARE_API_URL=https://care.local

# Patient-facing OTP login + public landing page: OFF. There is no SMS on an
# offline LAN, so an OTP can never reach a patient (see SMS_BACKEND in
# backend.env). Without this, https://care.local/ serves the public portal and
# anyone on the WiFi can try to log in as a patient. Hiding the UI is only half
# of it - the API side is closed by USE_SMS in clinic_settings.py.
REACT_DISABLE_PATIENT_LOGIN=true

# Empty on purpose: the login form renders a Google reCAPTCHA after a
# rate-limited (429) login, and google.com is unreachable offline. Empty key ->
# no widget at all, so staff get the plain "try again later" instead of a dead
# box. (This overrides the key baked into care_fe's committed .env.)
REACT_RECAPTCHA_SITE_KEY=

# Optional clinic tweaks (uncomment / edit as needed):
# REACT_ALLOWED_LOCALES="en,hi,ta,ml,mr,kn"
# REACT_DEFAULT_COUNTRY=
